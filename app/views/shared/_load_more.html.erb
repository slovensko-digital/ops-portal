<%# locals: (issues:) %>
<div data-controller="load-more" data-load-more-auto-loads-value="3">
  <div id="issues-items" class="podnet-block-con">
    <%= render issues %>
  </div>

  <div id="load-more-trigger" class="load-more-con" data-load-more-target="trigger">
    <%= render "shared/load_more_trigger", issues: issues %>
  </div>
</div>
