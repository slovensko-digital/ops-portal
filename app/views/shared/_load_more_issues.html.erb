<%# locals: (issues:, pagination:) %>
<div data-controller="load-more">
  <div id="issues-items" class="podnet-block-con">
    <%= render issues %>
  </div>

  <div id="load-more-trigger" class="load-more-con" data-load-more-target="trigger">
    <%= render "shared/load_more_issues_trigger", pagination: pagination %>
  </div>
</div>
