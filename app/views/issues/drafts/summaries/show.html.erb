<%= content_for(:title, 'Kontrola podnetu') %>
<section class="report">
  <h1>Zhrnutie podnetu</h1>

  <div class="report-suggestion-description">Skontrolujte údaje podnetu pred odoslaním.</div>

  <%= render "sections", draft: @draft, editable: true %>

  <%= button_to "Odoslať podnet", issues_draft_checks_path(@draft), class: "button button-with-submit-spinner",
                data: { turbo_submits_with: "Kontrolujeme podnet…" } %>
</section>
