<div class="form-item-wrapper">
  <% filter_id = "filter-#{tree_autocomplete.control.label.to_s.parameterize}" %>
  <label for="<%= filter_id %>"><%= tree_autocomplete.control.label %></label>

  <div class="autocomplete-wrapper"
       data-controller="tree-autocomplete"
       data-action="
        input->tree-autocomplete#filter
        keydown.enter->tree-autocomplete#enter
        keydown.esc->tree-autocomplete#closeOnEscape
        click@window->tree-autocomplete#closeOnOutsideClick">
    <input
      data-tree-autocomplete-target="input"
      data-action="focusin->tree-autocomplete#open"
      placeholder="<%= Array(tree_autocomplete.value).select { _1.is_a?(String) }.join(', ') %>"
      id="<%= filter_id %>"
      autocomplete="off" />

    <ul class="dropdown-list none"
        data-tree-autocomplete-target="list">
      <% tree_autocomplete.items.each do |item| %>
        <li
          data-tree-autocomplete-target="item"
          data-full-label="<%= item.value %>"
          data-level="<%= item.level %>"
          class="<%= class_names("check-box": tree_autocomplete.multiple, "nested-level-#{item.level}": item.level > 0, active: item.selected?) %>" >
          <%= link_to item.selected? ? item.remove_params : item.add_params, class: '' do %>
            <% if tree_autocomplete.multiple %>
              <div class="form-check-box">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 20">
                  <polygon points="5.51 15.78 0 10.26 1.06 9.2 5.51 13.66 14.94 4.22 16 5.28 5.51 15.78"/>
                </svg>
              </div>
            <% end %>
            <span class="<%= 'item-title--bold' if item.level == 0 %>"><%= item.label %></span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <div class="dropdown-not-found none" data-tree-autocomplete-target="empty" role="status">
      Pre „<strong data-tree-autocomplete-target="query"></strong>“ sme nenašli žiadnu obec ani mestskú časť.
      <span>Skontrolujte, či je názov napísaný správne.</span>
    </div>
  </div>
</div>
