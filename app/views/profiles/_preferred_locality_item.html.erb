<li class="<%= class_names("check-box", district: item[:is_district], active: item[:selected]) %>"
    data-preferred-localities-target="item"
    data-level="<%= item[:is_district] ? 1 : 0 %>"
    data-full-label="<%= item[:full_label] %>">
  <label class="check-box-label <%= 'check-box-label--district' if item[:is_district] %>">

    <%= f.check_box item[:field], {
      multiple: true,
      class: "sr-only",
      checked: item[:selected],
      data: {
        preferred_localities_target: "checkbox",
        label: item[:label],
        full_label: item[:full_label],
        district: item[:is_district],
        municipality_id: item[:municipality_id],
        action: "change->preferred-localities#toggleLocality"
      }
    }, item[:id], nil %>

    <div class="form-check-box">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 20">
        <polygon points="5.51 15.78 0 10.26 1.06 9.2 5.51 13.66 14.94 4.22 16 5.28 5.51 15.78"/>
      </svg>
      <span class="form-check-box-dash" aria-hidden="true"></span>
    </div>

    <span class="<%= class_names("item-title--bold": !item[:is_district]) %>"><%= item[:label] %></span>
  </label>
</li>
