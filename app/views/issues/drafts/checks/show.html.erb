<%= content_for :title, "Automatická kontrola podnetu" %>

<section class="report">
  <h1>Podnet má problém</h1>

  <% if @draft.municipality_errors? %>
    <%= render partial: 'issues/drafts/unsupported_municipality' %>
  <% elsif @draft.errors.added?(:base, :duplicates_nearby) %>
    <div class="report-summary-block-con">
      <div class="report-warning report-duplicates-notice">
        <div class="description">
          <p>V blízkosti podnetu sa už nachádzajú duplicitné podnety z&nbsp;rovnakej kategórie.</p>
        </div>
        <div class="report-duplicates-check">
          <%= link_to "Skontroluj duplicitný podnet", issues_draft_duplicates_path(@draft), class: "button" %>
          <div class="report-duplicates-hint">Váš podnet sa tak vybaví rýchlejšie</div>
        </div>
        <%= button_to "Registrovať ako nový podnet", issues_draft_checks_path(@draft, ignore_duplicates: 1), class: "button button-transparent" %>
      </div>
    </div>
  <% elsif @draft.checks.nil? %>
    <div class="report-summary-block-con">
      <div class="report-warning">
        <div class="title">Automatickú kontrolu sa nepodarilo vykonať</div>
        <div class="description">
          <p>Automatická kontrola podnetu momentálne nie je dostupná. Skúste to, prosím, o chvíľu znova.</p>
        </div>
      </div>
    </div>
  <% elsif @draft.errors[:checks].any? %>
    <%= render partial: 'checks', object: @draft.checks %>
  <% end %>
</section>
