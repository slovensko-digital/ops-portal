<% controller = Admin::MunicipalityBoundariesController %>

<details class="tree-select" data-municipality-boundaries-map-target="tree">
  <summary>
    Hranice:
    <span data-tree-summary="Žiadne"></span>
  </summary>

  <div class="tree-select-panel">
    <ul>
      <% controller::KINDS.each do |kind, kind_label| %>
        <li>
          <label>
            <%= check_box_tag nil, nil, false, id: "boundaries_#{kind}", data: { tree_parent: true } %>
            <span><%= kind_label %></span>
            <i class="swatch" style="background: var(--color-<%= kind %>);"></i>
          </label>
          <ul>
            <li>
              <label>
                <%= check_box_tag nil, nil, false, id: "boundaries_#{kind}_matched", data: { tree_parent: true } %>
                <span>Spárované</span>
              </label>
              <ul>
                <% controller::MATCHED_STATUSES.each do |status, label| %>
                  <li>
                    <label>
                      <%= check_box_tag "boundaries[]", "#{kind}:#{status}", boundaries.include?("#{kind}:#{status}"), id: "boundaries_#{kind}_#{status}" %>
                      <span><%= label %></span>
                    </label>
                  </li>
                <% end %>
              </ul>
            </li>
            <% controller::UNMATCHED_STATUS.each do |status, label| %>
              <li>
                <label>
                  <%= check_box_tag "boundaries[]", "#{kind}:#{status}", boundaries.include?("#{kind}:#{status}"), id: "boundaries_#{kind}_#{status}" %>
                  <span><%= label %></span>
                  <i class="swatch" style="background: var(--color-unmatched);"></i>
                </label>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </div>
</details>
