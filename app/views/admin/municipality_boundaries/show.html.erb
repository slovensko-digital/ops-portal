<% municipality = @boundary.municipality %>
<% district = @boundary.municipality_district %>

<%= turbo_frame_tag "boundary_detail" do %>
  <h2><%= district&.name || municipality&.name || "Nespárovaná hranica" %></h2>

  <h3>Hranica</h3>
  <dl>
    <dt>ID</dt>
    <dd><%= @boundary.id %></dd>
    <dt>Typ</dt>
    <dd><%= @boundary.boundary_kind == "district" ? "Mestská časť" : "Obec" %></dd>
    <dt>Spárovaná</dt>
    <dd><%= @boundary.matched? ? "áno" : "nie" %></dd>
  </dl>

  <h3>Obec</h3>
  <% if municipality %>
    <dl>
      <dt>ID</dt>
      <dd><%= municipality.id %></dd>
      <dt>Názov</dt>
      <dd><%= municipality.name %></dd>
      <dt>Aktívna</dt>
      <dd><%= municipality.active ? "áno" : "nie" %></dd>
    </dl>
  <% else %>
    <p>Hranica nie je spárovaná so žiadnou obcou.</p>
  <% end %>

  <% if district %>
    <h3>Mestská časť</h3>
    <dl>
      <dt>ID</dt>
      <dd><%= district.id %></dd>
      <dt>Názov</dt>
      <dd><%= district.name %></dd>
      <dt>Aktívna</dt>
      <dd><%= district.active ? "áno" : "nie" %></dd>
    </dl>
  <% end %>
<% end %>
