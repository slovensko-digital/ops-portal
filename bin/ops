#!/usr/bin/env ruby
# Local development only: starts, stops and resets the local stack, the portal's Postgres and database, the local
# Triage (../ops-triage-zammad) and the local Backoffices (../ops-backoffice-saas). See "bin/ops commands" in README.md.
#
# Commands:
#   bin/ops up [--backoffices=LIST] [--build]   # Start Postgres, Triage and the Backoffices, prepare the database
#   bin/ops down                                # Stop them all, keep the data
#   bin/ops status                              # Show what runs, its URLs and Docker memory
#   bin/ops reset [--backoffices=LIST] [--yes]  # Wipe them all and the portal's data, then start them like a first up
#   bin/ops logs TARGET [SERVICE]               # Follow the logs of portal, postgres, triage or a Backoffice
#
# Then bin/activate-seeded-municipalities on a fresh Triage, and bin/dev.
#
# Without --backoffices, up and reset start the Backoffices set up before, running or stopped, Malacky when there are
# none. reset always wipes every Backoffice, then starts only these.
#
# Options:

# up and reset start the Backoffices of config/local_backoffices.yml in --backoffices (none: only Triage), otherwise
# the ones that ran before (a .env.<instance> in ../ops-backoffice-saas), Malacky when none did; up stops the others,
# they keep their data.
#
# The portal uses the Postgres on the port of DATABASE_URL: whatever answers there (e.g. Postgres.app), otherwise
# bin/ops starts the Docker container ops-postgres. Triage and the Backoffices keep their databases there too
# (ops_triage_development, ops_backoffice_<instance>_development), they reach it on host.docker.internal:5432, see
# docker-compose.ops-postgres.yml in their repos. It only touches the compose projects ops-triage-zammad and
# ops-backoffice-<instance>, the container ops-postgres and these databases, never other projects (e.g.
# ops-triage-e2e) or other databases.
# Worktrees of this repo use the same ports and the same Postgres, run it from one of them at a time.
require "json"
require "yaml"
require "net/http"
require "fileutils"
require "open3"
require "optparse"
require "socket"

APP_ROOT = File.expand_path("..", __dir__)
TRIAGE_DIR = File.expand_path("../ops-triage-zammad", APP_ROOT)
BACKOFFICE_DIR = File.expand_path("../ops-backoffice-saas", APP_ROOT)
TRIAGE_PROJECT = "ops-triage-zammad"
TRIAGE_DATABASE = "ops_triage_development"
TRIAGE_PORT = 8080
POSTGRES_CONTAINER = "ops-postgres"
PORTAL_PORT = 3000
DEFAULT_BACKOFFICES = [ "malacky" ].freeze
LOCAL_BACKOFFICES = YAML.load_file(File.join(APP_ROOT, "config/local_backoffices.yml")).freeze
# the first start runs zammad-init, it takes minutes
ZAMMAD_TIMEOUT = 20 * 60

Backoffice = Data.define(:instance, :port) do
  def project = "ops-backoffice-#{instance}"
  def url = "http://#{instance}.localhost:#{port}"
  def mailpit_url = "http://localhost:#{port - 55}"
end

def run!(*command, chdir: APP_ROOT, env: {})
  puts "\n== #{command.join(" ")}#{" (in #{File.basename(chdir)})" unless chdir == APP_ROOT}"
  system(env, *command, chdir: chdir, exception: true)
end

def capture(*command)
  output, status = Open3.capture2(*command, err: File::NULL)
  status.success? ? output : ""
end

# ANSI colors for the names in run_parallel!'s output, only on a terminal
COLORS = [ 36, 35, 33, 32, 34, 31 ].freeze

def colored(text, index) = $stdout.tty? ? "\e[#{COLORS[index % COLORS.size]}m#{text}\e[0m" : text

# runs the steps of each name one after another and the names at once, { name => [[command, chdir], ...] },
# every output line starts with its name in a color of its own, aborts when any of them failed
def run_parallel!(steps)
  return if steps.empty?

  output = Mutex.new
  failed = steps.each_with_index.map do |(name, commands), index|
    tag = colored("[#{name}]", index)
    Thread.new do
      commands.all? do |command, chdir|
        output.synchronize { puts "\n== #{tag} #{command.join(" ")}" }
        Open3.popen2e(*command, chdir: chdir) do |_, out, wait|
          # docker compose starts its lines with a space already
          out.each_line { |line| output.synchronize { puts "#{tag} #{line.delete_prefix(" ")}" } }
          wait.value.success?
        end
      end || name
    end
  end.map(&:value).grep(String)
  abort "\n#{failed.join(", ")} failed, see the output above" if failed.any?
end

# docker-compose.ops-postgres.yml: Triage's database in the portal's Postgres. With -f, docker compose no longer loads
# docker-compose.override.yml by itself
def triage_files
  %w[docker-compose.yml docker-compose.override.yml docker-compose.ops-postgres.yml]
    .select { File.exist?(File.join(TRIAGE_DIR, _1)) }.flat_map { [ "-f", _1 ] }
end

def triage_compose(*args) = [ [ "docker", "compose", "-p", TRIAGE_PROJECT, *triage_files, *args ], TRIAGE_DIR ]
# dev/compose adds the Backoffice's docker-compose.ops-postgres.yml itself
def backoffice_compose(backoffice, *args) = [ [ "dev/compose", backoffice.instance, *args ], BACKOFFICE_DIR ]
def backoffice_database(instance) = "ops_backoffice_#{instance.tr("-", "_")}_development"

def known_backoffices
  Dir[File.join(BACKOFFICE_DIR, ".env.*")].filter_map do |path|
    instance = File.basename(path).delete_prefix(".env.")
    next if %w[sample test].include?(instance)

    port = File.read(path)[/^NGINX_EXPOSE_PORT=(\d+)/, 1]
    Backoffice.new(instance, port.to_i) if port
  end.sort_by(&:port)
end

def port_open?(port)
  Socket.tcp("127.0.0.1", port, connect_timeout: 1).close
  true
rescue SystemCallError, SocketError, IOError
  false
end

def http_ok?(url)
  uri = URI(url)
  Net::HTTP.start(uri.host, uri.port, open_timeout: 2, read_timeout: 5) { _1.get(uri.request_uri) }.is_a?(Net::HTTPSuccess)
rescue StandardError
  false
end

def zammad_ready?(port) = http_ok?("http://localhost:#{port}/api/v1/signshow")

# docker inspect of every container of a compose project, stopped ones too
def containers(project)
  ids = capture("docker", "ps", "-aq", "--filter", "label=com.docker.compose.project=#{project}").split
  ids.empty? ? [] : JSON.parse(capture("docker", "inspect", *ids).then { _1.empty? ? "[]" : _1 })
end

def service(container) = container.dig("Config", "Labels", "com.docker.compose.service")

# aborts when a container ran out of memory or a one-off container (e.g. a Backoffice's zammad-init) failed
def check_failures!(project)
  containers(project).each do |container|
    state = container["State"]
    name = container["Name"].delete_prefix("/")
    if state["OOMKilled"]
      abort "\n#{name} ran out of memory. Give Docker more memory (Settings → Resources, " \
        "about 1.5 GB per Zammad, Triage and 2 Backoffices need about 4.5 GB), then run the command again."
    end
    if state["Status"] == "exited" && state["ExitCode"] != 0 && container.dig("HostConfig", "RestartPolicy", "Name") == "no"
      abort "\n#{name} failed (exit code #{state["ExitCode"]}), see: docker logs #{name}"
    end
  end
end

# zammad-dev-setup creates the admin API token and the volunteer, it runs once Zammad is set up
def dev_setup_done?(project)
  setup = containers(project).find { service(_1) == "zammad-dev-setup" }
  setup.nil? || (setup.dig("State", "Status") == "exited" && setup.dig("State", "ExitCode") == 0)
end

# waits for every Zammad at once, { name => [project, port] }
def wait_for_zammads(zammads)
  return if zammads.empty?

  print "\n== Waiting for #{zammads.keys.join(", ")}, the first start takes a few minutes "
  deadline = Time.now + ZAMMAD_TIMEOUT
  pending = zammads.dup
  until pending.empty?
    pending.each_value { |project, _| check_failures!(project) }
    pending.reject! { |_, (project, port)| zammad_ready?(port) && dev_setup_done?(project) }
    break if pending.empty?
    abort "\n#{pending.keys.join(", ")} did not answer in #{ZAMMAD_TIMEOUT / 60} minutes, see bin/ops logs" if Time.now > deadline

    print "."
    sleep 5
  end
  puts " ready"
end

def database_url
  File.read(File.join(APP_ROOT, ".env"))[/^DATABASE_URL=(\S+)/, 1] || abort("No DATABASE_URL in .env")
end

def postgres_port = URI(database_url).port || 5432

# DATABASE_URL with another database, by default the maintenance database postgres
def postgres_url(database = "postgres") = URI(database_url).tap { _1.path = "/#{database}" }.to_s

def database?(name) = capture("psql", postgres_url, "-XtAc", "SELECT 1 FROM pg_database WHERE datname = '#{name}'").strip == "1"

# a step for run_parallel!, after the Zammad using the database stopped
def drop_database(name) = [ [ "psql", postgres_url, "-Xqc", %(DROP DATABASE IF EXISTS "#{name}" WITH (FORCE)) ], APP_ROOT ]

# The zammad-postgresql of a Zammad set up before it shared the portal's Postgres keeps running, docker compose no
# longer knows it. Removing it frees its memory, its volume stays until a reset. The Zammads start with empty
# databases, the portal still has them activated: a reset starts all of them fresh together.
def remove_own_postgres(reset: false)
  projects = [ TRIAGE_PROJECT, *known_backoffices.map(&:project) ]
  ids = projects.flat_map { |project| containers(project).select { service(_1) == "zammad-postgresql" }.map { _1["Id"] } }
  return if ids.empty?

  run!("docker", "rm", "-f", *ids)
  return if reset

  puts "\n== Triage and the Backoffices now keep their databases in the portal's Postgres and start empty. " \
    "Run bin/ops reset once, then bin/activate-seeded-municipalities"
end

# running, exited, ... or "" when there is no container
def docker_postgres_state = capture("docker", "inspect", "-f", "{{.State.Status}}", POSTGRES_CONTAINER).strip

# something else answers on the port (Postgres.app, Homebrew, another container), the portal uses it
def other_postgres? = docker_postgres_state != "running" && port_open?(postgres_port)

def ensure_bundle
  system("bundle check", chdir: APP_ROOT, out: File::NULL) || run!("bundle", "install")
end

def start_postgres
  if other_postgres?
    puts "\n== Postgres: something other than #{POSTGRES_CONTAINER} answers on port #{postgres_port}, the portal uses it"
    return
  end

  case docker_postgres_state
  # the project name of the main checkout, a worktree uses the same volume ops-portal_postgres_data
  when "" then run! "docker", "compose", "-p", "ops-portal", "up", "-d"
  # it may belong to the compose project of another worktree, start it as it is
  when "running" then nil
  else run! "docker", "start", POSTGRES_CONTAINER
  end

  deadline = Time.now + 60
  until system("docker", "exec", POSTGRES_CONTAINER, "pg_isready", "-q", "-U", URI(database_url).user, out: File::NULL, err: File::NULL)
    abort "Postgres in #{POSTGRES_CONTAINER} does not answer, see bin/ops logs postgres" if Time.now > deadline
    sleep 1
  end
end

def check_repos!
  { TRIAGE_DIR => "ops-triage-zammad", BACKOFFICE_DIR => "ops-backoffice-saas" }.each do |dir, repo|
    abort "No #{dir}, clone #{repo} next to this repo" unless Dir.exist?(dir)
  end
  return if File.exist?(File.join(APP_ROOT, ".env"))

  run! "cp", ".env.sample", ".env"
end

def check_portal_stopped!
  return unless port_open?(PORTAL_PORT)

  abort "Something runs on port #{PORTAL_PORT}, stop bin/dev first (also in the other worktrees)"
end

def print_next_step(fresh_triage)
  puts "\n== Ready. Next:"
  puts "  bin/activate-seeded-municipalities   # the fresh Triage has no municipalities yet" if fresh_triage
  puts(port_open?(PORTAL_PORT) ? "  the portal runs on http://localhost:#{PORTAL_PORT}" : "  bin/dev")
end

# the Backoffices to start: --backoffices, the ones that ran before, or Malacky
def picked_backoffices(options)
  instances = options[:backoffices] || known_backoffices.map(&:instance).then { _1.empty? ? DEFAULT_BACKOFFICES : _1 }
  unknown = instances - LOCAL_BACKOFFICES.map { _1["instance"] }
  abort "Unknown Backoffice #{unknown.join(", ")}, config/local_backoffices.yml has #{LOCAL_BACKOFFICES.map { _1["instance"] }.join(", ")}" if unknown.any?
  LOCAL_BACKOFFICES.select { instances.include?(_1["instance"]) }
end

# up -d starts a Backoffice with its .env.<instance>, the activation may have changed its ids there. dev/up writes it
# with the fixed values of config/local_backoffices.yml and (re)creates the Backoffice: a new one, and after a reset
def start_backoffice(config, build, fixed_values: false)
  backoffice = known_backoffices.find { _1.instance == config["instance"] }
  return backoffice_compose(backoffice, "up", "-d", *build) if backoffice && !fixed_values

  dev_up = config.values_at("instance", "slot", "name", "responsible_subject_id", "tenant_id", "api_token", "webhook_secret")
  [ [ "dev/up", *dev_up.map(&:to_s) ], BACKOFFICE_DIR ]
end

def zammads(backoffices)
  { "Triage" => [ TRIAGE_PROJECT, TRIAGE_PORT ] }.merge(backoffices.to_h { [ _1["instance"], [ "ops-backoffice-#{_1["instance"]}", 8080 + _1["slot"] ] ] })
end

# Gets the stack ready, also the first time: Postgres, the portal database (db:prepare creates and seeds a new one),
# Triage and the Backoffices, all at once, then waits until they answer.
def up(options)
  check_repos!
  backoffices = picked_backoffices(options)
  build = options[:build] ? [ "--build" ] : []
  known = known_backoffices

  ensure_bundle
  start_postgres
  remove_own_postgres
  fresh_triage = !database?(TRIAGE_DATABASE)
  # db:prepare creates and seeds a new database, migrates an existing one
  steps = { "portal" => [ [ [ "bin/rails", "db:prepare" ], APP_ROOT ] ], "triage" => [ triage_compose("up", "-d", *build) ] }
  # the others stop, it frees their memory (about 1.5 GB each), they keep their data
  known.each { steps[_1.instance] = [ backoffice_compose(_1, "stop") ] }
  backoffices.each { steps[_1["instance"]] = [ start_backoffice(_1, build) ] }
  run_parallel!(steps)

  wait_for_zammads(zammads(backoffices))
  status
  new_backoffices = backoffices.reject { |config| known.any? { _1.instance == config["instance"] } }
  if new_backoffices.any? && !fresh_triage
    puts "\n== #{new_backoffices.map { _1["name"] }.join(", ")} stays BASIC in the portal, it was activated without its new " \
      "Backoffice. To make it PRO: bin/ops reset, then bin/activate-seeded-municipalities"
  end
  print_next_step(fresh_triage)
end

def down
  check_repos!
  steps = { "triage" => [ triage_compose("stop") ] }.merge(known_backoffices.to_h { [ _1.instance, [ backoffice_compose(_1, "stop") ] ] })
  run_parallel!(steps)
  # last, Triage and the Backoffices use it too
  run!("docker", "stop", POSTGRES_CONTAINER) if docker_postgres_state == "running"
  puts "\n== The Postgres on port #{postgres_port} keeps running, it is not bin/ops's" if port_open?(postgres_port)
  puts "\n== Stopped, the data stays. Stop bin/dev with Ctrl-C." if port_open?(PORTAL_PORT)
end

# Wipes everything and gets the stack ready again, like a first up, all at once: Triage and every Backoffice with
# their volumes and databases (see "reset" in README.md), the portal's uploaded files, logs, tmp and database.
# The portal is filled by db:reset's seeds today, a restore of a prepared snapshot can replace it.
def reset(options)
  check_repos!
  check_portal_stopped!
  backoffices = picked_backoffices(options)
  confirm_reset!(backoffices, options[:yes])

  ensure_bundle
  start_postgres
  remove_own_postgres(reset: true)
  # the uploaded files (Active Storage's local service) belong to the database db:reset drops
  puts "\n== Removing the uploaded files in storage/"
  FileUtils.rm_rf(Dir[File.join(APP_ROOT, "storage", "[^.]*")])
  # log:clear tmp:clear as bin/setup does, tmp:clear empties the test uploads in tmp/storage too. db:reset, not
  # db:seed:replant: replant truncates PostGIS's spatial_ref_sys, the boundary import then fails
  steps = {
    "portal" => [ [ [ "bin/rails", "log:clear", "tmp:clear" ], APP_ROOT ], [ [ "bin/rails", "db:reset" ], APP_ROOT ] ],
    "triage" => [ triage_compose("down", "-v"), drop_database(TRIAGE_DATABASE), triage_compose("up", "-d") ]
  }
  known_backoffices.each { steps[_1.instance] = [ backoffice_compose(_1, "down", "-v") ] }
  # also a new Backoffice's, a database may stay from before
  (known_backoffices.map(&:instance) | backoffices.map { _1["instance"] }).each do |instance|
    (steps[instance] ||= []) << drop_database(backoffice_database(instance))
  end
  backoffices.each { (steps[_1["instance"]] ||= []) << start_backoffice(_1, [ "--build" ], fixed_values: true) }
  run_parallel!(steps)

  known_backoffices.reject { |known| backoffices.any? { _1["instance"] == known.instance } }.each do |backoffice|
    File.delete(File.join(BACKOFFICE_DIR, ".env.#{backoffice.instance}"))
    puts "== Removed .env.#{backoffice.instance}, the Backoffice #{backoffice.instance} is not started any more"
  end

  wait_for_zammads(zammads(backoffices))
  status
  print_next_step(true)
end

def confirm_reset!(backoffices, yes)
  return if yes

  message = "This wipes the portal database (#{URI(database_url).path.delete_prefix("/")}) and its uploaded files, " \
    "the local Triage and the " \
    "local Backoffices (#{known_backoffices.map(&:instance).join(", ").then { _1.empty? ? "none yet" : _1 }}), " \
    "then starts #{backoffices.empty? ? "no Backoffice" : "the Backoffices #{backoffices.map { _1["instance"] }.join(", ")}"}."
  abort "#{message} Run it with --yes." unless $stdin.tty?

  print "#{message} Continue? [y/N] "
  abort "Nothing changed." unless $stdin.gets.to_s.strip.downcase.start_with?("y")
end

def parse_bytes(text)
  number, unit = text.strip.match(/\A([\d.]+)\s*([KMGT]?i?B)\z/)&.captures
  return 0 unless number

  number.to_f * 1024**({ "B" => 0, "KiB" => 1, "MiB" => 2, "MB" => 2, "GiB" => 3, "GB" => 3, "TiB" => 4 }[unit] || 0)
end

def gigabytes(bytes) = format("%.1f GB", bytes / 1024.0**3)

def status
  usage = capture("docker", "stats", "--no-stream", "--format", "{{.Name}}\t{{.MemUsage}}").lines.to_h do |line|
    name, memory = line.chomp.split("\t")
    [ name, parse_bytes(memory.to_s.split("/").first.to_s) ]
  end
  memory = ->(prefix) { usage.select { |name, _| name.start_with?(prefix) }.values.sum }

  rows = [ [ "Portal", port_open?(PORTAL_PORT) ? "running" : "stopped (bin/dev)", "http://localhost:#{PORTAL_PORT}", "" ] ]
  if other_postgres?
    rows << [ "Postgres", "not #{POSTGRES_CONTAINER}, answers", "localhost:#{postgres_port}", "" ]
  else
    postgres = docker_postgres_state
    rows << [ "Postgres", postgres.empty? ? "missing" : postgres, "localhost:#{postgres_port}", gigabytes(memory.(POSTGRES_CONTAINER)) ]
  end
  rows << zammad_row("Triage", TRIAGE_PROJECT, TRIAGE_PORT, "http://localhost:#{TRIAGE_PORT}", "http://localhost:8025", memory)
  known_backoffices.each { rows << zammad_row("Backoffice #{_1.instance}", _1.project, _1.port, _1.url, _1.mailpit_url, memory) }

  puts
  widths = rows.transpose.map { |column| column.map(&:length).max }
  rows.each { |row| puts row.zip(widths).map { |cell, width| cell.ljust(width) }.join("  ").rstrip }
  databases = capture("psql", postgres_url, "-XtAc", "SELECT datname FROM pg_database WHERE datname LIKE 'ops\\_%' ORDER BY 1").split
  if databases.any?
    puts "\nDatabases on localhost:#{postgres_port}: #{databases.join(", ")}"
    puts "Connect: psql #{postgres_url("")}<database>"
    puts "  without psql: docker exec -it #{POSTGRES_CONTAINER} psql -U #{URI(database_url).user} -d <database>" unless other_postgres?
  end
  total = capture("docker", "info", "--format", "{{.MemTotal}}").to_i
  puts "\nDocker memory: #{gigabytes(usage.values.sum)} used of #{gigabytes(total)} (about 1.5 GB per Zammad)"
end

def zammad_row(name, project, port, url, mailpit_url, memory)
  all = containers(project)
  running = all.count { _1.dig("State", "Status") == "running" }
  oom = all.select { _1.dig("State", "OOMKilled") }.map { service(_1) }
  state =
    if all.empty? then "missing (bin/ops reset)"
    elsif running.zero? then "stopped"
    elsif zammad_ready?(port) then "ready"
    else "starting (#{running}/#{all.size} containers)"
    end
  state += ", out of memory: #{oom.join(", ")}" if oom.any?
  [ name, state, "#{url}, Mailpit #{mailpit_url}", gigabytes(memory.("#{project}-")) ]
end

def logs(target, service)
  if target == "portal"
    exec "tail", "-f", File.join(APP_ROOT, "log/development.log")
  elsif target == "postgres"
    abort "The portal uses a Postgres other than #{POSTGRES_CONTAINER}, see its own logs" if other_postgres?
    exec "docker", "logs", "-f", "--tail", "100", POSTGRES_CONTAINER
  end

  args = [ "logs", "-f", "--tail", "100", *service ]
  if target == "triage"
    Dir.chdir(TRIAGE_DIR) { exec "docker", "compose", "-p", TRIAGE_PROJECT, *triage_files, *args }
  elsif known_backoffices.any? { _1.instance == target }
    Dir.chdir(BACKOFFICE_DIR) { exec "dev/compose", target, *args }
  else
    abort "Unknown #{target}, use portal, postgres, triage or a Backoffice: #{known_backoffices.map(&:instance).join(", ")}"
  end
end

$stdout.sync = true
options = {}
parser = OptionParser.new do |opts|
  # the help is the first comment block of this file
  opts.banner = File.readlines(__FILE__).drop(1).take_while { _1.start_with?("#") }.map { _1.sub(/^# ?/, "") }.join.chomp
  opts.on("--backoffices=LIST", "up, reset: Backoffices to start, e.g. malacky,trnava or none") do |list|
    options[:backoffices] = list.split(",").map(&:strip) - [ "none", "" ]
  end
  opts.on("--build", "up: rebuild the Zammad images") { options[:build] = true }
  opts.on("--yes", "reset: don't ask") { options[:yes] = true }
end
arguments = begin
  parser.parse(ARGV)
rescue OptionParser::ParseError => e
  abort "#{e.message}, see bin/ops --help"
end

case arguments.shift
when "up" then up(options)
when "down" then down
when "status" then status
when "reset" then reset(options)
when "logs" then logs(arguments.shift || abort(parser.banner), arguments.shift)
else abort parser.help
end
