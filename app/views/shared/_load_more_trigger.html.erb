<%# locals: (issues:) %>
<% if issues.next_page %>
  <%= link_to "Načítať ďalšie podnety",
              url_for(page: issues.next_page),
              class: "button",
              data: { action: "click->load-more#loadMore", load_more_target: "button" } %>
<% end %>
<div class="pagination-con" data-load-more-target="pagination">
  <%= ops_paginate(issues) %>
</div>
