#!/usr/bin/env ruby

# Check if foreman gem is installed, install it if not
unless system("gem list foreman -i --silent")
  puts "Installing foreman..."
  system("gem install foreman") || abort("Failed to install foreman")
end

# foreman gives the first process PORT=5000 otherwise, which macOS AirPlay uses, Puma reads PORT
ENV["PORT"] ||= "3000"

exec "foreman", "start", "-f", "Procfile.dev", *ARGV
